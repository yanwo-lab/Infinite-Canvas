# Infinite Canvas development environment

# code-server / Codex
if [ -x /envs/uv/bin/uv ] && [ -x "$(pwd)/.venv-code/bin/python" ]; then
    export UV_BIN=/envs/uv/bin/uv
    export UV_PYTHON_INSTALL_DIR=/envs/python
    export CANVAS_PYTHON_ENV="$(pwd)/.venv-code"

# NAS host
elif [ -x /opt/dev-envs/uv/bin/uv ] && [ -x "$(pwd)/.venv-host/bin/python" ]; then
    export UV_BIN=/opt/dev-envs/uv/bin/uv
    export UV_PYTHON_INSTALL_DIR=/opt/dev-envs/python
    export CANVAS_PYTHON_ENV="$(pwd)/.venv-host"

else
    echo "Infinite Canvas development environment not found." >&2
    return 1 2>/dev/null || exit 1
fi

export PATH="$(dirname "$UV_BIN"):$CANVAS_PYTHON_ENV/bin:$PATH"
export VIRTUAL_ENV="$CANVAS_PYTHON_ENV"

unset PYTHONHOME
