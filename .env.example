# Host paths used only by Docker Compose. Relative paths are resolved from
# the directory containing compose.yml.
CANVAS_HOST_DATA_DIR=./docker-data/data
CANVAS_HOST_UPLOADS_DIR=./docker-data/uploads
CANVAS_HOST_CACHE_DIR=./docker-data/cache
CANVAS_HOST_OUTPUT_DIR=./docker-data/output

# Published HTTP port on the host.
CANVAS_HOST_PORT=3000
